{
  "name": "robot-station",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev": "npm run dev -w @robot-station/server",
    "build": "npm run build -w @robot-station/protocol && npm run build -w @robot-station/server",
    "start": "npm run start -w @robot-station/server",
    "test": "npm run test -w @robot-station/protocol",
    "test:integration": "npm run build && node --test tests/control_gateway.test.mjs",
    "typecheck": "npm run build -w @robot-station/protocol && npm run typecheck -w @robot-station/server"
  },
  "engines": { "node": ">=22" },
  "devDependencies": { "tsx": "^4.19.2", "typescript": "^5.7.3" }
}